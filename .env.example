VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=affiches-em
# ============================================================================
# AFFICHES-EM v1.0 — Variables d'environnement
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet
# Appwrite (etape 0.3). `.env.local` n'est jamais versionne.
#
# Ces deux valeurs sont publiques par conception : elles figurent dans tout
# code client Appwrite. La securite repose sur les permissions declarees cote
# serveur, jamais sur leur confidentialite.
#
# N'AJOUTEZ JAMAIS DE CLE API DANS CE FICHIER.
# ============================================================================
 
# Point d'entree Appwrite Cloud (region a adapter selon votre projet)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
 
# Identifiant du projet, visible dans la console Appwrite
VITE_APPWRITE_PROJECT_ID=
 
# Identifiant de la base de donnees (creee a l'etape 0.4)
VITE_APPWRITE_DATABASE_ID=affiches-em
 
# ----------------------------------------------------------------------------
# Cle API — UNIQUEMENT pour le script d'installation (npm run setup:appwrite)
# ----------------------------------------------------------------------------
# Contrairement aux valeurs ci-dessus, celle-ci est un VRAI secret : elle donne
# un acces administrateur complet au projet. Elle n'a volontairement pas de
# prefixe VITE_, ce qui garantit que Vite ne l'inclura jamais dans le code
# compile. Supprimez-la de .env.local une fois l'installation terminee.
#
# APPWRITE_API_KEY=